# Copy this file to .env and fill in your values.
# Never commit .env — only .env.example is committed.

# Database
POSTGRES_DB=minhavenda
POSTGRES_USER=minhavenda
POSTGRES_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=changeme

# Spring
SPRING_PROFILES_ACTIVE=dev

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=changeme_use_at_least_32_characters_here
JWT_EXPIRATION=86400000

# Mail — Mailhog defaults for dev (no real emails sent)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
